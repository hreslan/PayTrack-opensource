# Copy this file to ".env" and fill in the values. Never commit real secrets
# — .env is git-ignored.

# ---- Database (local SQLite file) ----
DATABASE_URL="file:./dev.db"

# ---- Auth ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-32-byte-hex-string"
AUTH_TRUST_HOST=true
# The public URL the app is served at. Required once it's reachable from
# anywhere other than localhost (e.g. behind a Cloudflare Tunnel or reverse
# proxy) — without it, NextAuth may build redirect/callback URLs wrong.
# AUTH_URL="https://your-domain.example.com"

# ---- Two-step verification: email delivery (free via Gmail) ----
# 1. Turn on 2-Step Verification for your Google account:
#    https://myaccount.google.com/security
# 2. Create an "App password": https://myaccount.google.com/apppasswords
# 3. Uncomment these lines and fill in your address + the 16-character app password:
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT="465"
# EMAIL_SERVER_USER="you@example.com"
# EMAIL_SERVER_PASSWORD="your 16-char app password"
# EMAIL_FROM="PayTrack <you@example.com>"
#
# Until these are set, verification codes are printed in the server terminal.

# ---- AI document parsing (optional, via Gemini flash-lite) ----
# With a key set, uploaded payslips and receipts of ANY layout are parsed by
# Gemini (flash-lite); without it, the built-in pattern parser is used. The
# extracted document text is sent to Google to be parsed (it is not stored by
# this app). Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=""

# ---- Two-step verification: SMS delivery (paid, via Twilio) ----
# Requires a Twilio account (twilio.com) with a phone number. Not free.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+1xxxxxxxxxx"
