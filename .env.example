# Copy this file to ".env" for local development, and set the same variables in
# your Vercel project settings for production. Never commit real secrets.

# ---- Database (Neon Postgres) ----
# From the Neon dashboard "Connection string". Use the POOLED string (host
# contains "-pooler") for DATABASE_URL, and the DIRECT (non-pooled) string for
# DIRECT_URL. Keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ---- Auth ----
# Generate a value with:  openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-32-byte-hex-string"
AUTH_TRUST_HOST=true

# ---- Two-step verification email (optional) ----
# Until these are set, login codes are printed to the server logs instead of sent.
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT="465"
# EMAIL_SERVER_USER="you@example.com"
# EMAIL_SERVER_PASSWORD="your-gmail-app-password"
# EMAIL_FROM="PayTrack <you@example.com>"

# ---- AI document parsing (optional) ----
# Without a key, the built-in pattern parser is used.
# DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://integrate.api.nvidia.com/v1/chat/completions"
# DEEPSEEK_MODEL="deepseek-ai/deepseek-v4-pro"

# ---- Two-step verification SMS (optional, paid) ----
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+1xxxxxxxxxx"
